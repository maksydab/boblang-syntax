{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Boblang",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.bob",
					"match": "#.*$"
				},
				{
					"name": "comment.line.bob",
					"match": "^\\s*//.*$"
				},
				{
					"name": "comment.line.bob",
					"match": "--.*$"
				},
				{
					"name": "comment.block.bob",
					"begin": "/\\*",
					"end": "\\*/"
				},
				{
					"name": "comment.block.bob",
					"begin": "--\\[\\[",
					"end": "\\]\\]"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.bob",
					"match": "\\b(if|else|elseif|for|while|in|return|end|do|then)\\b"
				},
				{
					"name": "keyword.operator.bob",
					"match": "[+\\-*/%=<>!]+"
				},
				{
					"name": "support.function.bob",
					"match": "\\b(print)\\b"
				},
				{
					"name": "storage.type.return.bob",
					"match": "\\)\\s*([A-Za-z_][A-Za-z0-9_]*)"
				},
				{
					"name": "keyword.storage.function.bob",
					"match": "\\b(func|function)\\b"
				},
				{
					"name": "constant.numeric.bob",
					"match": "\\b[0-9]+(\\.[0-9]+)?\\b"
				},
				{
					"name": "constant.language.bob",
					"match": "\\b(nil|true|false)\\b"
				},
				{
					"name": "entity.name.type.class.bob",
					"match": "\\b(str|int|float|bool|bigi|bigf)\\b"
				},
				{
					"name": "keyword.operator.bob",
					"match": "\\b(and|or|not|is|in)\\b"
				},
				{
					"name": "keyword.operator.assignment.bob",
					"match": "="
				},
				{
					"name": "entity.name.function.bob",
					"match": "\\b(func|function)\\s+([a-zA-Z_][a-zA-Z0-9_]*)"
				},
				{
					"name": "keyword.storage.class.bob",
					"match": "\\bclass\\b"
				},
				{
					"name": "entity.name.type.class.bob",
					"match": "\\b(class)\\s+([A-Z_a-z][A-Za-z0-9_]*)"
				},
				{
					"name": "punctuation.separator.type.bob",
					"match": ":"
				},
				{
					"name": "entity.name.function.decorator.bob",
					"match": "@[a-zA-Z_][a-zA-Z0-9_]*"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.bob",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.bob",
					"match": "\\\\."
				}
			]
		}
	},
	"scopeName": "source.boblang"
}